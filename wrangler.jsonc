{
  "name": "tidy-hollow-coach",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://jarredksmith.github.io",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "10421011",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
